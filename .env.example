# ---------------------------------------------------------------------------
# Brandwide Analytics Dashboard — environment variables
#
# Set these in Netlify:  Site configuration -> Environment variables
# Locally: copy to `.env` (already git-ignored) and run `netlify dev`.
# Any block you leave blank simply renders that panel in demo mode.
# ---------------------------------------------------------------------------

# --- Google service account (used by BOTH GA4 and Search Console) -----------
# From the service-account JSON key file you download in Google Cloud.
GOOGLE_CLIENT_EMAIL="brandwide-dashboard@your-project.iam.gserviceaccount.com"
# Paste the whole private_key value including the BEGIN/END lines.
# Keep the literal \n escapes exactly as they appear in the JSON file.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# --- Google Analytics 4 -----------------------------------------------------
# Numeric property ID only (Admin -> Property Settings), e.g. 123456789
GA4_PROPERTY_ID="123456789"

# --- Google Search Console --------------------------------------------------
# Exactly as it appears in Search Console:
#   Domain property : sc-domain:brandwide.com
#   URL prefix      : https://www.brandwide.com/
GSC_SITE_URL="sc-domain:brandwide.com"

# --- Mouseflow --------------------------------------------------------------
# Two ways to feed the Behaviour report. The function prefers an API key,
# falls back to the committed snapshot, and only then shows sample data.
#
# 1. Public API (only useful on a plan whose API returns real data).
MOUSEFLOW_USERNAME=""
MOUSEFLOW_API_KEY=""
MOUSEFLOW_REGION="us"
MOUSEFLOW_WEBSITE_ID=""
#
# 2. Snapshot sync (what this plan uses). A shared secret the bookmarklet
#    sends as the x-ingest-secret header. Generate a long random value:
#      openssl rand -base64 32
MOUSEFLOW_INGEST_SECRET=""
#
#    A GitHub token with contents:write on Ralphmarino/brandwide, used to
#    commit the merged snapshot. A fine-grained token limited to that one
#    repository is strongly preferred over a classic token.
GITHUB_TOKEN=""

# --- Optional access gate ---------------------------------------------------
# Set to enable HTTP basic auth in front of the whole dashboard.
# Leave blank to disable (use Netlify's own password protection instead).
DASHBOARD_USER=""
DASHBOARD_PASSWORD=""
